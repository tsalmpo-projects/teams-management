<%
  sc = subject_classes(@user.department)
  initials = [@user.firstname, @user.lastname].compact.map { |n| n[0] }.join.upcase
  initials = @user.email[0..1].upcase if initials.blank?
  name = [@user.firstname, @user.lastname].compact.join(" ")
  name = @user.email.split("@").first if name.blank?
  dept_label = @user.department&.titleize || "Not set"
  is_self = user_signed_in? && current_user.id == @user.id
%>

<div class="py-6">
  <div class="max-w-2xl mx-auto">
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">

      <%# Profile header with colored banner %>
      <div class="h-32 bg-linear-to-r <%= sc[:from] %> <%= sc[:to] %>"></div>

      <div class="px-6 pb-6">
        <%# Avatar overlapping the banner %>
        <div class="-mt-12 mb-4">
          <div class="h-24 w-24 rounded-full <%= sc[:bg] %> flex items-center justify-center text-2xl font-bold <%= sc[:text] %> border-4 border-white shadow-sm">
            <%= initials %>
          </div>
        </div>

        <%# User info %>
        <h1 class="text-2xl font-bold text-gray-900 mb-1"><%= name %></h1>

        <% if @user.bio.present? %>
          <p class="text-sm text-gray-600 mt-2 mb-4"><%= @user.bio %></p>
        <% end %>

        <div class="space-y-3 mt-4">
          <div class="flex items-center gap-3">
            <svg class="h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
            </svg>
            <span class="text-sm text-gray-600"><%= @user.email %></span>
          </div>

          <div class="flex items-center gap-3">
            <svg class="h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.438 60.438 0 0 0-.491 6.347A48.62 48.62 0 0 1 12 20.904a48.62 48.62 0 0 1 8.232-4.41 60.46 60.46 0 0 0-.491-6.347m-15.482 0a50.636 50.636 0 0 0-2.658-.813A59.906 59.906 0 0 1 12 3.493a59.903 59.903 0 0 1 10.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.717 50.717 0 0 1 12 13.489a50.702 50.702 0 0 1 7.74-3.342M6.75 15a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm0 0v-3.675A55.378 55.378 0 0 1 12 8.443m-7.007 11.55A5.981 5.981 0 0 0 6.75 15.75v-1.5" />
            </svg>
            <span class="inline-flex items-center rounded-full <%= sc[:bg] %> px-3 py-0.5 text-sm font-medium <%= sc[:text] %>"><%= dept_label %></span>
          </div>
        </div>

        <%# Action buttons %>
        <div class="flex items-center gap-3 mt-6 pt-6 border-t border-gray-200">
          <% if is_self %>
            <%= link_to edit_user_registration_path, class: "inline-flex items-center gap-2 rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-medium text-white hover:bg-blue-700 transition-colors" do %>
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10" />
              </svg>
              Edit Profile
            <% end %>
          <% else %>
            <%= link_to conversation_path(@user), class: "inline-flex items-center gap-2 rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-medium text-white hover:bg-blue-700 transition-colors" do %>
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H8.25m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H12m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 0 1-2.555-.337A5.972 5.972 0 0 1 5.41 20.97a5.969 5.969 0 0 1-.474-.065 4.48 4.48 0 0 0 .978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25Z" />
              </svg>
              Send Message
            <% end %>
          <% end %>
          <%= link_to "Back", :back, class: "rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-sm font-medium text-gray-700 hover:bg-gray-50 transition-colors" %>
        </div>
      </div>
    </div>
  </div>
</div>
