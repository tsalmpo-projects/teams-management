<%
  dept_colors = { "computer_science" => "blue", "physics" => "green", "math" => "purple", "chemistry" => "yellow" }
  color = dept_colors[@assignment.user.department] || "blue"
  author = @assignment.user
  initials = [author.firstname, author.lastname].compact.map { |n| n[0] }.join.upcase
  initials = author.email[0..1].upcase if initials.blank?
  name = [author.firstname, author.lastname].compact.join(" ")
  name = author.email.split("@").first if name.blank?
  dept_label = author.department&.titleize || "Unknown"
  owner = user_signed_in? && current_user.id == @assignment.user_id
%>

<div class="py-6">
  <div class="max-w-3xl mx-auto">

    <%# Back link %>
    <div class="mb-6">
      <%= link_to (owner ? assignments_path : root_path), class: "inline-flex items-center gap-1 text-sm text-gray-500 hover:text-gray-700 transition-colors" do %>
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
        </svg>
        Back to assignments
      <% end %>
    </div>

    <%# Assignment card %>
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 border-l-4 border-l-<%= color %>-600 overflow-hidden">
      <div class="p-6 sm:p-8">

        <%# Header %>
        <div class="mb-6">
          <h1 class="text-2xl font-bold text-gray-900 mb-2"><%= @assignment.title %></h1>
          <div class="flex items-center gap-3 flex-wrap">
            <span class="inline-flex items-center rounded-full bg-<%= color %>-100 px-3 py-0.5 text-sm font-medium text-<%= color %>-700"><%= dept_label %></span>
            <span class="text-sm text-gray-500">Posted <%= time_ago_in_words(@assignment.created_at) %> ago</span>
          </div>
        </div>

        <%# Body %>
        <div class="text-sm text-gray-700 mb-8 whitespace-pre-line"><%= @assignment.body %></div>

        <%# Author section %>
        <div class="border-t border-gray-200 pt-6 mb-6">
          <p class="text-xs font-medium text-gray-500 uppercase tracking-wider mb-3">Posted by</p>
          <%= link_to profile_path(author.id), class: "inline-flex items-center gap-3 hover:bg-gray-50 -ml-2 px-2 py-1.5 rounded-lg transition-colors" do %>
            <div class="h-10 w-10 rounded-full bg-<%= color %>-100 flex items-center justify-center text-sm font-medium text-<%= color %>-700"><%= initials %></div>
            <div>
              <p class="text-sm font-medium text-gray-900"><%= name %></p>
              <p class="text-xs text-<%= color %>-600"><%= dept_label %></p>
            </div>
          <% end %>
        </div>

        <%# Actions %>
        <div class="border-t border-gray-200 pt-6 flex items-center gap-3">
          <% if owner %>
            <%= link_to assignment_path(@assignment), data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete this assignment?" }, class: "inline-flex items-center gap-2 rounded-lg bg-red-600 px-5 py-2.5 text-sm font-medium text-white hover:bg-red-700 transition-colors" do %>
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
              </svg>
              Delete Assignment
            <% end %>
          <% else %>
            <button class="inline-flex items-center gap-2 rounded-lg bg-blue-600 px-5 py-2.5 text-sm font-medium text-white hover:bg-blue-700 transition-colors cursor-pointer">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M18 7.5v3m0 0v3m0-3h3m-3 0h-3m-2.25-4.125a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0ZM3 19.235v-.11a6.375 6.375 0 0 1 12.75 0v.109A12.318 12.318 0 0 1 9.374 21c-2.331 0-4.512-.645-6.374-1.766Z" />
              </svg>
              Request to Join Assignment
            </button>
          <% end %>
        </div>

      </div>
    </div>
  </div>
</div>
