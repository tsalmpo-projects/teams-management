<%
  sc = subject_classes(@assignment.subject)
  stc = status_classes(@assignment.status)
  author = @assignment.user
  author_sc = subject_classes(author&.department)
  initials = display_initials(author)
  name = display_name(author)
  subject_label = @assignment.subject&.titleize || "Unknown"
  author_dept_label = author&.department&.titleize || "Not set"
  status_label = @assignment.status&.titleize || "Published"
  owner = user_signed_in? && @assignment.user_id.present? && current_user.id == @assignment.user_id
  team = @assignment.team
  members = team&.members || []
%>

<div class="py-6">
  <div class="max-w-3xl mx-auto">

    <%# Back link %>
    <div class="mb-6">
      <%= link_to (owner ? assignments_path : root_path), class: "inline-flex items-center gap-1 text-sm text-gray-500 hover:text-gray-700 transition-colors" do %>
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
        </svg>
        Back to assignments
      <% end %>
    </div>

    <%# Assignment card %>
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 border-l-4 <%= sc[:border] %> overflow-hidden">
      <div class="p-6 sm:p-8">

        <%# Header %>
        <div class="mb-6">
          <h1 class="text-2xl font-bold text-gray-900 mb-2"><%= @assignment.title %></h1>
          <div class="flex items-center gap-3 flex-wrap">
            <span class="inline-flex items-center rounded-full <%= sc[:bg] %> px-3 py-0.5 text-sm font-medium <%= sc[:text] %>"><%= subject_label %></span>
            <span class="inline-flex items-center rounded-full <%= stc[:bg] %> px-3 py-0.5 text-sm font-medium <%= stc[:text] %>"><%= status_label %></span>
            <span class="text-sm text-gray-500">Posted <%= time_ago_in_words(@assignment.created_at) %> ago</span>
            <% if @assignment.due_date %>
              <span class="text-sm text-gray-500">Due <%= @assignment.due_date.strftime("%B %d, %Y") %></span>
            <% end %>
          </div>
        </div>

        <%# Body %>
        <div class="text-sm text-gray-700 mb-8 whitespace-pre-line"><%= @assignment.body %></div>

        <%# Author section %>
        <div class="border-t border-gray-200 pt-6 mb-6">
          <p class="text-xs font-medium text-gray-500 uppercase tracking-wider mb-3">Posted by</p>
          <%= link_to (author ? profile_path(author.id) : "#"), class: "inline-flex items-center gap-3 hover:bg-gray-50 -ml-2 px-2 py-1.5 rounded-lg transition-colors" do %>
            <div class="h-10 w-10 rounded-full <%= author_sc[:bg] %> flex items-center justify-center text-sm font-medium <%= author_sc[:text] %>"><%= initials %></div>
            <div>
              <p class="text-sm font-medium text-gray-900"><%= name %></p>
              <p class="text-xs <%= author_sc[:accent] %>"><%= author_dept_label %></p>
            </div>
          <% end %>
        </div>

        <%# Status change (owner only) %>
        <% if owner %>
          <%
            status_options = [
              { key: "published",  label: "Published",  icon_path: "M12 7.5h1.5m-1.5 3h1.5m-7.5 3h7.5m-7.5 3h7.5m3-9h3.375c.621 0 1.125.504 1.125 1.125V18a2.25 2.25 0 0 1-2.25 2.25M16.5 7.5V18a2.25 2.25 0 0 0 2.25 2.25M16.5 7.5V4.875c0-.621-.504-1.125-1.125-1.125H4.125C3.504 3.75 3 4.254 3 4.875V18a2.25 2.25 0 0 0 2.25 2.25h13.5M6 7.5h3v3H6v-3Z",  active_bg: "bg-gray-900",  active_text: "text-white",  inactive_bg: "bg-white",       inactive_text: "text-gray-600", ring: "ring-gray-200" },
              { key: "in_process", label: "In Process", icon_path: "M11.42 15.17 17.25 21A2.652 2.652 0 0 0 21 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 1 1-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 0 0 4.486-6.336l-3.276 3.277a3.004 3.004 0 0 1-2.25-2.25l3.276-3.276a4.5 4.5 0 0 0-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085", active_bg: "bg-blue-600",  active_text: "text-white",  inactive_bg: "bg-white",       inactive_text: "text-gray-600", ring: "ring-gray-200" },
              { key: "completed",  label: "Completed",  icon_path: "M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z",                                                                                                                                                                                                                                                                                                                                                                                                                                               active_bg: "bg-green-600", active_text: "text-white",  inactive_bg: "bg-white",       inactive_text: "text-gray-600", ring: "ring-gray-200" }
            ]
          %>
          <div class="border-t border-gray-200 pt-6 mb-6">
            <p class="text-xs font-medium text-gray-500 uppercase tracking-wider mb-3">Status</p>
            <div class="flex gap-2">
              <% status_options.each do |opt| %>
                <% active = @assignment.status == opt[:key] %>
                <% if active %>
                  <div class="inline-flex items-center gap-2 rounded-full px-4 py-2 text-sm font-medium shadow-sm <%= opt[:active_bg] %> <%= opt[:active_text] %>">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d="<%= opt[:icon_path] %>" />
                    </svg>
                    <%= opt[:label] %>
                  </div>
                <% else %>
                  <%= form_with model: @assignment, method: :patch, class: "inline" do |form| %>
                    <%= form.hidden_field :status, value: opt[:key] %>
                    <button type="submit" class="inline-flex items-center gap-2 rounded-full border px-4 py-2 text-sm font-medium transition-all cursor-pointer <%= opt[:inactive_bg] %> <%= opt[:inactive_text] %> border-gray-200 hover:border-gray-300 hover:bg-gray-50 hover:shadow-sm">
                      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="<%= opt[:icon_path] %>" />
                      </svg>
                      <%= opt[:label] %>
                    </button>
                  <% end %>
                <% end %>
              <% end %>
            </div>
          </div>
        <% end %>

        <%# Actions %>
        <div class="border-t border-gray-200 pt-6 flex items-center gap-3">
          <% if owner && @assignment.deletable? %>
            <%= link_to assignment_path(@assignment), data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete this assignment?" }, class: "inline-flex items-center gap-2 rounded-lg bg-red-600 px-5 py-2.5 text-sm font-medium text-white hover:bg-red-700 transition-colors" do %>
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
              </svg>
              Delete Assignment
            <% end %>
          <% elsif user_signed_in? && @assignment.published? && @assignment.user_id.present? %>
            <% if @join_request.nil? %>
              <%= form_with url: join_request_assignment_path(@assignment), method: :post, class: "inline" do %>
                <button type="submit" class="inline-flex items-center gap-2 rounded-lg bg-blue-600 px-5 py-2.5 text-sm font-medium text-white hover:bg-blue-700 transition-colors cursor-pointer">
                  <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M18 7.5v3m0 0v3m0-3h3m-3 0h-3m-2.25-4.125a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0ZM3 19.235v-.11a6.375 6.375 0 0 1 12.75 0v.109A12.318 12.318 0 0 1 9.374 21c-2.331 0-4.512-.645-6.374-1.766Z" />
                  </svg>
                  Request to Join Assignment
                </button>
              <% end %>
            <% elsif @join_request.declined == true %>
              <button disabled class="inline-flex items-center gap-2 rounded-lg bg-red-100 px-5 py-2.5 text-sm font-medium text-red-700 cursor-not-allowed">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M18.364 18.364A9 9 0 0 0 5.636 5.636m12.728 12.728A9 9 0 0 1 5.636 5.636m12.728 12.728L5.636 5.636" />
                </svg>
                Request Declined
              </button>
            <% elsif @join_request.declined == false %>
              <button disabled class="inline-flex items-center gap-2 rounded-lg bg-green-100 px-5 py-2.5 text-sm font-medium text-green-700 cursor-not-allowed">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                </svg>
                Request Accepted
              </button>
            <% else %>
              <button disabled class="inline-flex items-center gap-2 rounded-lg bg-gray-100 px-5 py-2.5 text-sm font-medium text-gray-500 cursor-not-allowed">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                </svg>
                Request Sent
              </button>
            <% end %>
          <% end %>
        </div>

      </div>
    </div>

    <%# Team Members section %>
    <% if members.any? %>
      <div class="mt-8 bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
        <div class="p-6 sm:p-8">
          <h2 class="text-lg font-semibold text-gray-900 mb-4">Team Members</h2>
          <div class="space-y-3">
            <% members.each do |member| %>
              <%
                member_name = display_name(member)
                member_initials = display_initials(member)
              %>
              <%= link_to (member ? profile_path(member) : "#"), class: "flex items-center gap-3 p-3 rounded-lg hover:bg-gray-50 transition-colors" do %>
                <div class="h-9 w-9 rounded-full bg-blue-100 flex items-center justify-center text-xs font-medium text-blue-700"><%= member_initials %></div>
                <div>
                  <p class="text-sm font-medium text-gray-900"><%= member_name %></p>
                  <p class="text-xs text-gray-500"><%= member&.email || "—" %></p>
                </div>
              <% end %>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>

    <%# Join Requests section (owner only) %>
    <% if owner %>
      <% join_requests = Message.where(assignment_id: @assignment.id, declined: nil) %>
      <% if join_requests.any? %>
        <div class="mt-8 bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
          <div class="p-6 sm:p-8">
            <h2 class="text-lg font-semibold text-gray-900 mb-4">Join Requests</h2>
            <div class="space-y-4">
              <% join_requests.each do |message| %>
                <%
                  sender = message.sender
                  sender_name = display_name(sender)
                  sender_initials = display_initials(sender)
                %>
                <div class="flex items-center justify-between gap-4 p-4 rounded-lg border border-gray-100 bg-gray-50">
                  <div class="flex items-center gap-3">
                    <div class="h-9 w-9 rounded-full bg-blue-100 flex items-center justify-center text-xs font-medium text-blue-700"><%= sender_initials %></div>
                    <div>
                      <p class="text-sm font-medium text-gray-900"><%= sender_name %></p>
                      <p class="text-xs text-gray-500"><%= time_ago_in_words(message.created_at) %> ago</p>
                    </div>
                  </div>
                  <div class="flex items-center gap-2">
                    <%= form_with url: handle_join_request_assignment_path(@assignment, message_id: message.id, declined: "false"), method: :patch, class: "inline" do %>
                      <button type="submit" class="rounded-lg bg-green-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-green-700 transition-colors cursor-pointer">Accept</button>
                    <% end %>
                    <%= form_with url: handle_join_request_assignment_path(@assignment, message_id: message.id, declined: "true"), method: :patch, class: "inline" do %>
                      <button type="submit" class="rounded-lg bg-red-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-red-700 transition-colors cursor-pointer">Decline</button>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    <% end %>

  </div>
</div>
