<% if user_signed_in? %>
  <%
    subjects = [
      ["All", nil],
      ["Computer Science", "computer_science"],
      ["Physics", "physics"],
      ["Math", "math"],
      ["Chemistry", "chemistry"]
    ]
  %>

  <div class="py-6">
    <h1 class="text-2xl font-bold text-gray-900 mb-1">Published Assignments</h1>
    <p class="text-gray-600 mb-6">Browse assignments posted by students across all departments.</p>

    <%# Subject filter pills %>
    <div class="flex flex-wrap gap-2 mb-8">
      <% subjects.each do |label, value| %>
        <% active = params[:subject] == value || (value.nil? && params[:subject].blank?) %>
        <%= link_to label, root_path(subject: value),
              class: "rounded-full px-4 py-1.5 text-sm font-medium transition-colors #{active ? 'bg-gray-900 text-white' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'}" %>
      <% end %>
    </div>

    <% if @assignments.any? %>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        <% @assignments.each do |assignment| %>
          <%
            sc = subject_classes(assignment.subject)
            author = assignment.user
            author_sc = subject_classes(author.department)
            initials = [author.firstname, author.lastname].compact.map { |n| n[0] }.join.upcase
            initials = author.email[0..1].upcase if initials.blank?
            name = [author.firstname, author.lastname].compact.join(" ")
            name = author.email.split("@").first if name.blank?
            subject_label = assignment.subject&.titleize || "Unknown"
            author_dept_label = author.department&.titleize || "Not set"
          %>

          <div class="bg-white rounded-xl shadow-sm border border-gray-200 border-l-4 <%= sc[:border] %> p-5 flex flex-col justify-between">
            <div>
              <%= link_to assignment.title, assignment_path(assignment), class: "text-lg font-semibold text-gray-900 mb-2 block hover:text-blue-600 transition-colors" %>
              <span class="inline-flex items-center rounded-full <%= sc[:bg] %> px-2.5 py-0.5 text-xs font-medium <%= sc[:text] %> mb-2"><%= subject_label %></span>
              <p class="text-sm text-gray-600 line-clamp-3"><%= assignment.body %></p>
            </div>
            <%= link_to profile_path(author), class: "flex items-center gap-3 mt-4 pt-4 border-t border-gray-100 hover:bg-gray-50 -mx-5 -mb-5 px-5 pb-5 pt-4 rounded-b-xl transition-colors" do %>
              <div class="h-8 w-8 rounded-full <%= author_sc[:bg] %> flex items-center justify-center text-xs font-medium <%= author_sc[:text] %>"><%= initials %></div>
              <div>
                <p class="text-sm font-medium text-gray-900"><%= name %></p>
                <p class="text-xs <%= author_sc[:accent] %>"><%= author_dept_label %></p>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-gray-500 text-sm">No assignments found.</p>
    <% end %>
  </div>
<% else %>
  <div class="py-16 text-center">
    <h1 class="text-4xl font-bold text-gray-900 sm:text-5xl mb-4">Teams Management</h1>
    <p class="text-lg text-gray-600 max-w-2xl mx-auto mb-8">Collaborate on university assignments with your classmates. Create teams, manage assignments, and communicate — all in one place.</p>

    <div class="flex items-center justify-center gap-4 mb-16">
      <%= link_to "Get Started", new_user_registration_path, class: "rounded-lg bg-blue-600 px-6 py-3 text-sm font-medium text-white hover:bg-blue-700 transition-colors" %>
      <%= link_to "Sign In", new_user_session_path, class: "rounded-lg border border-gray-300 bg-white px-6 py-3 text-sm font-medium text-gray-700 hover:bg-gray-50 transition-colors" %>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-4xl mx-auto">
      <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 text-left">
        <div class="rounded-lg bg-blue-100 p-2 w-fit mb-4">
          <svg class="h-6 w-6 text-blue-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-gray-900 mb-2">Create Assignments</h3>
        <p class="text-sm text-gray-600">Post assignments and track progress across your courses.</p>
      </div>

      <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 text-left">
        <div class="rounded-lg bg-green-100 p-2 w-fit mb-4">
          <svg class="h-6 w-6 text-green-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 0 0 3.741-.479 3 3 0 0 0-4.682-2.72m.94 3.198.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0 1 12 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 0 1 6 18.719m12 0a5.971 5.971 0 0 0-.941-3.197m0 0A5.995 5.995 0 0 0 12 12.75a5.995 5.995 0 0 0-5.058 2.772m0 0a3 3 0 0 0-4.681 2.72 8.986 8.986 0 0 0 3.74.477m.94-3.197a5.971 5.971 0 0 0-.94 3.197M15 6.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm6 3a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Zm-13.5 0a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Z" />
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-gray-900 mb-2">Form Teams</h3>
        <p class="text-sm text-gray-600">Build teams with classmates and organize your group work.</p>
      </div>

      <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 text-left">
        <div class="rounded-lg bg-gray-100 p-2 w-fit mb-4">
          <svg class="h-6 w-6 text-gray-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H8.25m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H12m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 0 1-2.555-.337A5.972 5.972 0 0 1 5.41 20.97a5.969 5.969 0 0 1-.474-.065 4.48 4.48 0 0 0 .978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25Z" />
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-gray-900 mb-2">Collaborate</h3>
        <p class="text-sm text-gray-600">Communicate with your team through built-in messaging.</p>
      </div>
    </div>
  </div>
<% end %>
