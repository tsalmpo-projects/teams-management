<header class="bg-white shadow-sm border-b border-gray-200 sticky top-0 z-50">
  <nav class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between">
      <div class="flex items-center gap-6">
        <%= link_to root_path, class: "text-xl font-bold text-gray-900 hover:text-gray-700 transition-colors" do %>
          Teams Management
        <% end %>
        <% if user_signed_in? %>
          <div class="hidden sm:flex items-center gap-4">
            <%= link_to "My Assignments", my_assignments_path, class: "text-sm font-medium text-gray-600 hover:text-gray-900 transition-colors" %>
            <%= link_to "Teams", teams_path, class: "text-sm font-medium text-gray-600 hover:text-gray-900 transition-colors" %>
          </div>
        <% end %>
      </div>

      <div class="flex items-center gap-4">
        <% if user_signed_in? %>
          <%= link_to messages_path, class: "text-gray-500 hover:text-gray-700 transition-colors" do %>
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
            </svg>
          <% end %>
          <span class="text-sm text-gray-500"><%= current_user.email %></span>
          <%= link_to "Edit Profile", edit_user_registration_path, class: "text-sm font-medium text-gray-600 hover:text-gray-900 transition-colors" %>
          <%= button_to "Sign Out", destroy_user_session_path, method: :delete, class: "text-sm font-medium text-red-600 hover:text-red-700 transition-colors cursor-pointer" %>
        <% else %>
          <%= link_to "Sign In", new_user_session_path, class: "text-sm font-medium text-gray-600 hover:text-gray-900 transition-colors" %>
          <%= link_to "Sign Up", new_user_registration_path, class: "rounded-lg bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700 transition-colors" %>
        <% end %>
      </div>
    </div>
  </nav>
</header>
