<header class="bg-white shadow-sm border-b border-gray-200 sticky top-0 z-50">
  <nav class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between">
      <div class="flex items-center gap-6">
        <%= link_to root_path, class: "text-xl font-bold text-gray-900 hover:text-gray-700 transition-colors" do %>
          Teams Management
        <% end %>
        <% if user_signed_in? %>
          <div class="hidden sm:flex items-center gap-4">
            <%= link_to "My Assignments", assignments_path, class: "text-sm font-medium text-gray-600 hover:text-gray-900 transition-colors" %>
            <%= link_to "Teams", teams_path, class: "text-sm font-medium text-gray-600 hover:text-gray-900 transition-colors" %>
          </div>
        <% end %>
      </div>

      <div class="flex items-center gap-4">
        <% if user_signed_in? %>
          <% unread_dm_count = Message.where(recipient_id: current_user.id, team_id: nil, assignment_id: nil, read: false).count %>
          <%= link_to messages_path, class: "relative text-gray-500 hover:text-gray-700 transition-colors" do %>
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
            </svg>
            <span data-notification-target="badge" style="<%= 'display:none' if unread_dm_count == 0 %>" class="absolute -top-2 -right-2 inline-flex items-center justify-center h-4 min-w-4 rounded-full bg-red-500 px-1 text-[10px] font-bold text-white"><%= unread_dm_count if unread_dm_count > 0 %></span>
          <% end %>
          <%
            user_initials = [current_user.firstname, current_user.lastname].compact.map { |n| n[0] }.join.upcase
            user_initials = current_user.email[0..1].upcase if user_initials.blank?
            user_display = [current_user.firstname, current_user.lastname].compact.join(" ")
            user_display = current_user.email.split("@").first if user_display.blank?
          %>
          <div class="relative" data-controller="dropdown">
            <button data-action="click->dropdown#toggle" class="flex items-center gap-2 cursor-pointer rounded-full hover:ring-2 hover:ring-gray-300 transition-shadow">
              <div class="h-9 w-9 rounded-full bg-blue-100 flex items-center justify-center text-sm font-medium text-blue-700"><%= user_initials %></div>
            </button>
            <div data-dropdown-target="menu" class="hidden absolute right-0 mt-2 w-56 rounded-xl bg-white border border-gray-200 shadow-lg py-2 z-50">
              <div class="px-4 py-2 border-b border-gray-100">
                <p class="text-sm font-medium text-gray-900 truncate"><%= user_display %></p>
                <p class="text-xs text-gray-500 truncate"><%= current_user.email %></p>
              </div>
              <%= link_to profile_path(current_user), class: "flex items-center gap-2 px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 transition-colors" do %>
                <svg class="h-4 w-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
                </svg>
                My Profile
              <% end %>
              <%= link_to edit_user_registration_path, class: "flex items-center gap-2 px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 transition-colors" do %>
                <svg class="h-4 w-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.325.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 0 1 1.37.49l1.296 2.247a1.125 1.125 0 0 1-.26 1.431l-1.003.827c-.293.241-.438.613-.43.992a7.723 7.723 0 0 1 0 .255c-.008.378.137.75.43.991l1.004.827c.424.35.534.955.26 1.43l-1.298 2.247a1.125 1.125 0 0 1-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.47 6.47 0 0 1-.22.128c-.331.183-.581.495-.644.869l-.213 1.281c-.09.543-.56.94-1.11.94h-2.594c-.55 0-1.019-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 0 1-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 0 1-1.369-.49l-1.297-2.247a1.125 1.125 0 0 1 .26-1.431l1.004-.827c.292-.24.437-.613.43-.991a6.932 6.932 0 0 1 0-.255c.007-.38-.138-.751-.43-.992l-1.004-.827a1.125 1.125 0 0 1-.26-1.43l1.297-2.247a1.125 1.125 0 0 1 1.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.086.22-.128.332-.183.582-.495.644-.869l.214-1.28Z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                </svg>
                Edit Profile
              <% end %>
              <div class="border-t border-gray-100 mt-1 pt-1">
                <%= button_to destroy_user_session_path, method: :delete, class: "flex items-center gap-2 w-full px-4 py-2 text-sm text-red-600 hover:bg-red-50 transition-colors cursor-pointer" do %>
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6a2.25 2.25 0 0 0-2.25 2.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15m3 0 3-3m0 0-3-3m3 3H9" />
                  </svg>
                  Sign Out
                <% end %>
              </div>
            </div>
          </div>
        <% else %>
          <%= link_to "Sign In", new_user_session_path, class: "text-sm font-medium text-gray-600 hover:text-gray-900 transition-colors" %>
          <%= link_to "Sign Up", new_user_registration_path, class: "rounded-lg bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700 transition-colors" %>
        <% end %>
      </div>
    </div>
  </nav>
</header>
