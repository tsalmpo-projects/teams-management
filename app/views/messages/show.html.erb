<% content_for :fullscreen, true %>

<%
  other_name = display_name(@selected_user)
  other_initials = display_initials(@selected_user)

  current_name = display_name(current_user)
  current_initials = display_initials(current_user)

  conversation_id = [current_user.id, @selected_user.id].sort.join("_")
%>

<div class="flex flex-1 overflow-hidden">

  <%# Left panel — sidebar with tabs %>
  <%= render "messages/sidebar" %>

  <%# Right panel — conversation %>
  <div class="flex-1 flex flex-col bg-white"
       data-controller="chat"
       data-chat-conversation-id-value="<%= conversation_id %>"
       data-chat-current-user-id-value="<%= current_user.id %>"
       data-chat-current-user-name-value="<%= current_name %>"
       data-chat-current-user-initials-value="<%= current_initials %>"
       data-chat-send-url-value="<%= send_message_path(@selected_user) %>"
       data-chat-csrf-token-value="<%= form_authenticity_token %>"
       data-chat-recipient-id-value="<%= @selected_user.id %>"
       data-chat-recipient-name-value="<%= other_name %>"
       data-chat-recipient-initials-value="<%= other_initials %>"
       data-chat-conversation-url-value="<%= conversation_path(@selected_user) %>">

    <%# Conversation header %>
    <div class="p-4 border-b border-gray-200 flex items-center gap-3">
      <%= link_to profile_path(@selected_user), class: "h-10 w-10 rounded-full bg-blue-100 flex items-center justify-center text-sm font-medium text-blue-700 shrink-0 hover:ring-2 hover:ring-blue-300 transition" do %>
        <%= other_initials %>
      <% end %>
      <div>
        <%= link_to other_name, profile_path(@selected_user), class: "text-sm font-semibold text-gray-900 hover:text-blue-600 transition-colors" %>
        <p class="text-xs text-gray-500" data-chat-target="typingIndicator">&nbsp;</p>
      </div>
    </div>

    <%# Messages area %>
    <div class="flex-1 overflow-y-auto p-4 space-y-4" data-chat-target="messagesContainer">
      <% @messages.each do |msg| %>
        <% is_mine = msg.sender_id == current_user.id %>
        <div class="flex items-end gap-2 <%= is_mine ? 'justify-end' : 'justify-start' %>" data-message-id="<%= msg.id %>" <%= 'data-mine="true"' if is_mine %>>
          <% unless is_mine %>
            <div class="h-8 w-8 rounded-full bg-blue-100 flex items-center justify-center text-xs font-medium text-blue-700 shrink-0">
              <%= other_initials %>
            </div>
          <% end %>
          <div class="max-w-md">
            <div class="rounded-2xl px-4 py-2 text-sm <%= is_mine ? 'bg-blue-600 text-white' : 'bg-gray-100 text-gray-900' %>">
              <%= msg.content %>
            </div>
            <p class="text-xs text-gray-400 mt-1 <%= is_mine ? 'text-right' : '' %> read-receipt">
              <%= msg.created_at.strftime("%-I:%M %p") %>
              <% if is_mine && msg.read? %>
                <span class="read-check text-blue-500">&#10003;&#10003;</span>
              <% end %>
            </p>
          </div>
        </div>
      <% end %>
    </div>

    <%# Input area %>
    <div class="p-4 border-t border-gray-200">
      <div class="flex items-end gap-3">
        <textarea
          data-chat-target="input"
          data-action="input->chat#onTyping keydown->chat#onKeydown"
          placeholder="Type a message..."
          rows="1"
          class="flex-1 resize-none rounded-xl border border-gray-300 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
        ></textarea>
        <button
          data-action="click->chat#send"
          class="inline-flex items-center justify-center h-10 w-10 rounded-full bg-blue-600 text-white hover:bg-blue-700 transition-colors shrink-0 cursor-pointer">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 12 3.269 3.125A59.769 59.769 0 0 1 21.485 12 59.768 59.768 0 0 1 3.27 20.875L5.999 12Zm0 0h7.5" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</div>
