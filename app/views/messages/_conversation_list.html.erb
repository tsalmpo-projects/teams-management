<div class="overflow-y-auto flex-1">
  <%# DM Conversations %>
  <% if @conversations.any? %>
    <div class="px-4 pt-3 pb-1">
      <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Direct Messages</p>
    </div>
    <% @conversations.each do |msg| %>
      <%
        other_user = msg.sender_id == current_user.id ? msg.recipient : msg.sender
        next unless other_user
        other_name = display_name(other_user)
        other_initials = display_initials(other_user)
        active = @selected_user&.id == other_user.id
        unread_count = Message.where(sender_id: other_user.id, recipient_id: current_user.id, team_id: nil, assignment_id: nil, read: false).count
      %>
      <%= link_to conversation_path(other_user), data: { turbo_action: "advance" }, class: "flex items-start gap-3 p-4 border-l-4 transition-colors #{active ? 'bg-blue-50 border-l-blue-600' : 'border-l-transparent hover:bg-gray-50'}" do %>
        <div class="h-10 w-10 rounded-full bg-blue-100 flex items-center justify-center text-sm font-medium text-blue-700 shrink-0"><%= other_initials %></div>
        <div class="min-w-0 flex-1">
          <div class="flex items-center justify-between gap-2">
            <p class="text-sm font-semibold text-gray-900 truncate"><%= other_name %></p>
            <% if unread_count > 0 %>
              <span class="shrink-0 inline-flex items-center justify-center h-5 min-w-5 rounded-full bg-blue-600 px-1.5 text-xs font-medium text-white"><%= unread_count %></span>
            <% end %>
          </div>
          <p class="text-xs text-gray-500 truncate"><%= msg.content&.truncate(40) %></p>
        </div>
      <% end %>
    <% end %>
  <% end %>

  <%# Team Conversations %>
  <% if @team_conversations.present? && @team_conversations.any? %>
    <div class="px-4 pt-4 pb-1 border-t border-gray-100">
      <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Teams</p>
    </div>
    <% @team_conversations.each do |tc| %>
      <%
        team = tc[:team]
        last_msg = tc[:last_message]
        team_name = team.assignment&.title || "Team ##{team.id}"
        team_initial = team_name[0].upcase
        active = defined?(@team) && @team&.id == team.id
      %>
      <%= link_to team_conversation_path(team), data: { turbo_action: "advance" }, class: "flex items-start gap-3 p-4 border-l-4 transition-colors #{active ? 'bg-blue-50 border-l-blue-600' : 'border-l-transparent hover:bg-gray-50'}" do %>
        <div class="h-10 w-10 rounded-full bg-purple-100 flex items-center justify-center text-sm font-medium text-purple-700 shrink-0">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 0 0 3.741-.479 3 3 0 0 0-4.682-2.72m.94 3.198.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0 1 12 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 0 1 6 18.719m12 0a5.971 5.971 0 0 0-.941-3.197m0 0A5.995 5.995 0 0 0 12 12.75a5.995 5.995 0 0 0-5.058 2.772m0 0a3 3 0 0 0-4.681 2.72 8.986 8.986 0 0 0 3.74.477m.94-3.197a5.971 5.971 0 0 0-.94 3.197M15 6.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm6 3a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Zm-13.5 0a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Z" />
          </svg>
        </div>
        <div class="min-w-0 flex-1">
          <div class="flex items-center justify-between gap-2">
            <p class="text-sm font-semibold text-gray-900 truncate"><%= team_name %></p>
            <span class="shrink-0 text-xs text-gray-400"><%= team.members.size %></span>
          </div>
          <p class="text-xs text-gray-500 truncate"><%= last_msg ? last_msg.content&.truncate(40) : "No messages yet" %></p>
        </div>
      <% end %>
    <% end %>
  <% end %>

  <% if @conversations.empty? && (@team_conversations.blank? || @team_conversations.empty?) %>
    <div class="p-6 text-center text-sm text-gray-500">No conversations yet.</div>
  <% end %>
</div>
